{
  "name": "jira-delivery-mcp",
  "version": "2.0.0-beta.3",
  "mcpName": "io.github.teransarathchandra/jira-delivery-mcp",
  "description": "Client-agnostic MCP server for Jira and Confluence — delivery intelligence, implementation prompts, and workflow automation for any AI coding agent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jira-delivery-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "USAGE_GUIDE.md",
    "LICENSE",
    ".env.example",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Teran Sarathchandra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teransarathchandra/jira-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/teransarathchandra/jira-mcp-server/issues"
  },
  "homepage": "https://github.com/teransarathchandra/jira-mcp-server#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "jira",
    "confluence",
    "atlassian",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "ai-agent",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"import('fs').then(fs => fs.chmodSync('dist/index.js', 0o755))\"",
    "dev": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=moderate",
    "prepublishOnly": "npm run typecheck && npm run build",
    "eval": "npm run build --silent && vitest run --config evals/vitest.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^20.19.43",
    "typescript": "^5.3.0",
    "vitest": "^4.1.12"
  }
}
