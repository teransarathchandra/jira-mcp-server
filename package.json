{
  "name": "jira-delivery-mcp",
  "version": "2.0.0",
  "mcpName": "io.github.teransarathchandra/jira-delivery-mcp",
  "description": "MCP server and agent skill for Jira Cloud: ready-to-build briefs, branch checks against acceptance criteria, QA handoffs and safe write-back for Claude Code, Cursor, VS Code and any MCP client",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jira-delivery-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Teran Sarathchandra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teransarathchandra/jira-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/teransarathchandra/jira-mcp-server/issues"
  },
  "homepage": "https://github.com/teransarathchandra/jira-mcp-server#readme",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "jira",
    "jira-cloud",
    "confluence",
    "atlassian",
    "claude-code",
    "cursor",
    "vscode",
    "github-copilot",
    "codex",
    "agent-skills",
    "ai-agents",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"import('fs').then(fs => fs.chmodSync('dist/index.js', 0o755))\"",
    "dev": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=moderate",
    "prepublishOnly": "npm run typecheck && npm run build",
    "eval": "npm run build --silent && vitest run --config evals/vitest.config.ts",
    "skill:pack": "node scripts/pack-skill.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
