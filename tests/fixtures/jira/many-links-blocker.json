    "GET /rest/api/3/issue/ABC-1": {
      "status": 200,
      "body": {
        "id": "10001",
        "key": "ABC-1",
        "fields": {
          "summary": "Add login rate limiting",
          "description": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Limit failed login attempts per account to stop brute-force attacks."
                  }
                ]
              },
              {
                "type": "heading",
                "attrs": {
                  "level": 3
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Acceptance Criteria"
                  }
                ]
              },
              {
                "type": "bulletList",
                "content": [
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Lock the account for 15 minutes after 5 failed login attempts"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Show a lockout message with the remaining lock time"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "status": {
            "name": "To Do",
            "statusCategory": {
              "key": "new"
            }
          },
          "priority": {
            "name": "Medium"
          },
          "assignee": null,
          "reporter": {
            "displayName": "Product Owner"
          },
          "labels": [
            "security"
          ],
          "components": [
